APP_ENV=development
APP_MODE=demo

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Frontend setting (place in frontend/.env.local); requests use the Next.js proxy.
NEXT_PUBLIC_API_URL=/api

DATABASE_URL=postgresql+psycopg://rgv:rgv@localhost:5432/rgv

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=medlineplus

LLM_PROVIDER=demo
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=
VLLM_API_KEY=local

VERIFIER_PROVIDER=heuristic
VERIFIER_MODEL=
VERIFIER_THRESHOLD=0.80

MEDLINEPLUS_SNAPSHOT_DATE=
MEDLINEPLUS_CORPUS_PATH=data/medlineplus/snapshot.jsonl
DEFAULT_TOP_K=3
MAX_CORRECTION_ATTEMPTS=2
MAX_UPLOAD_BYTES=20971520
